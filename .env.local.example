# Referrals.com — local environment template
#
# Canonical reference: docs/.env.example (keep in sync)
# Copy to `.env` or `.env.local` at project root:
#   cp .env.local.example .env

# =============================================================================
# Database
# =============================================================================

DATABASE_URL="mysql://username:password@your-rds-host.amazonaws.com:3306/referral_program"
DATABASE_URL_VNOC="mysql://username:password@your-vnoc-host.amazonaws.com:3306/domaindi_managedomain"

# =============================================================================
# Auth (NextAuth)
# =============================================================================

NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# =============================================================================
# OAuth — Sign-in providers
# =============================================================================

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
NEXT_PUBLIC_FACEBOOK_APP_ID=""

# =============================================================================
# PayPal
# =============================================================================

PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_MODE="sandbox"
PAYPAL_PRODUCT_ID=""
# Webhook ID from PayPal Developer Dashboard → Apps → Webhooks
PAYPAL_WEBHOOK_ID=""

# =============================================================================
# AWS (SES email)
# =============================================================================

AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_SES_FROM_EMAIL="noreply@yourdomain.com"

# =============================================================================
# Integrations
# =============================================================================

SHOPIFY_CLIENT_ID=""
SHOPIFY_CLIENT_SECRET=""
NEXT_PUBLIC_SHOPIFY_CLIENT_ID=""

# =============================================================================
# Cron
# =============================================================================

CRON_SECRET="generate-with: openssl rand -hex 32"

# =============================================================================
# AI & content
# =============================================================================

OPENAI_API_KEY=""
OPENAI_IMAGE_MODEL="gpt-image-1-mini"
PEXELS_API_KEY=""

# =============================================================================
# App
# =============================================================================

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional — see docs/.env.example for full list
# WIDGET_ENCRYPTION_KEY=""
# SKIP_PAID_SUBSCRIPTION_GATE="true"
# ADMIN_EMAILS=""
# ADMIN_MEMBER_IDS=""
