# Copy to `.env.local` and fill in values. Never commit `.env.local`.
# See docs/shopify-integration.md for Shopify Partner + Vercel setup.

# --- App ---
# Use a pooler URL in production when MySQL max_connections is small (e.g. Vercel + RDS).
DATABASE_URL="mysql://user:password@host:3306/referrals"
# Optional: Prisma/Vercel pooler or RDS Proxy URL (preferred over direct when set).
DATABASE_URL_POOLED=""
# Per serverless isolate (default 1). Only applied when the URL is not already pooled.
DATABASE_CONNECTION_LIMIT="1"
DATABASE_POOL_TIMEOUT="30"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
AUTH_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Brand analysis pipeline ---
# Random string; required in production so /api/brands/analyze/[jobId]/run/* accepts triggers.
# Omit locally — modules run in-process via after() instead of HTTP fan-out.
ANALYSIS_INTERNAL_SECRET=""
# Optional override for module fan-out (defaults to NEXT_PUBLIC_APP_URL, then VERCEL_URL).
ANALYSIS_FANOUT_URL=""

# --- Shopify (R2) ---
# Server: OAuth token exchange in /api/integrations/shopify/oauth
SHOPIFY_CLIENT_ID=""
SHOPIFY_CLIENT_SECRET=""
# Browser: authorize redirect on /integrations/shopify (same Client ID as above)
NEXT_PUBLIC_SHOPIFY_CLIENT_ID=""
# --- Network operator APIs (VNOC / affiliate landers) ---
# Read: GET /api/v1/network/referrals
NETWORK_READ_KEY=""
# Write: POST /api/v1/network/conversions (falls back to NETWORK_READ_KEY if unset)
NETWORK_WRITE_KEY=""
