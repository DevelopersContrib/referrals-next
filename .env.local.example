# Referrals.com — local environment template
#
# Canonical reference: docs/.env.example (keep in sync)
# Copy to `.env` or `.env.local` at project root:
#   cp .env.local.example .env

# =============================================================================
# Database
# =============================================================================

DATABASE_URL="mysql://username:password@your-rds-host.amazonaws.com:3306/referral_program"
# VNOC/contrib brand network (used by the AI onboarding to pull authoritative logos/socials)
VNOC_DATABASE_URL="mysql://username:password@your-vnoc-host.amazonaws.com:3306/contrib_rdb"

# =============================================================================
# Auth (NextAuth)
# =============================================================================

NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# =============================================================================
# OAuth — Sign-in providers
# =============================================================================

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
NEXT_PUBLIC_FACEBOOK_APP_ID=""

# =============================================================================
# PayPal
# =============================================================================

PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_MODE="sandbox"
PAYPAL_PRODUCT_ID=""
# Webhook ID from PayPal Developer Dashboard → Apps → Webhooks
PAYPAL_WEBHOOK_ID=""

# =============================================================================
# AWS (SES email)
# =============================================================================

AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_SES_FROM_EMAIL="noreply@yourdomain.com"

# =============================================================================
# Integrations
# =============================================================================

SHOPIFY_CLIENT_ID=""
SHOPIFY_CLIENT_SECRET=""
NEXT_PUBLIC_SHOPIFY_CLIENT_ID=""

# =============================================================================
# Cron
# =============================================================================

CRON_SECRET="generate-with: openssl rand -hex 32"

# =============================================================================
# AI & content
# =============================================================================

OPENAI_API_KEY=""
OPENAI_IMAGE_MODEL="gpt-image-1-mini"
PEXELS_API_KEY=""

# =============================================================================
# AI Brand Intelligence onboarding pipeline
# =============================================================================

# Guards the internal per-module runner endpoint used for serverless fan-out.
ANALYSIS_INTERNAL_SECRET="generate-with: openssl rand -hex 32"
# Optional (v2): RapidAPI key for SEO / tech-detection / reputation enrichment.
RAPIDAPI_KEY=""

# =============================================================================
# App
# =============================================================================

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# =============================================================================
# AWS — SES (email)
# =============================================================================

AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_SES_FROM_EMAIL="send@referrals.com"

# =============================================================================
# AWS — S3 (file uploads / campaign images)
# =============================================================================

AWS_S3_BUCKET="referralsassets"
AWS_S3_ACCESS_KEY_ID=""
AWS_S3_SECRET_ACCESS_KEY=""
# Optional CDN URL (e.g. CloudFront): AWS_S3_CDN_URL="https://cdn.referrals.com"

# =============================================================================
# Optional
# =============================================================================

# WIDGET_ENCRYPTION_KEY=""
# SKIP_PAID_SUBSCRIPTION_GATE="true"
# ADMIN_EMAILS=""
# ADMIN_MEMBER_IDS=""

# Comma-separated emails granted platform admin (the ONLY way to grant admin)
ADMIN_EMAILS=

# =============================================================================
# VNOC attribution postback (server-to-server; keep real tokens in .env only)
# =============================================================================
# Shared for referrals.com (domain 971)
VNOC_ATTRIBUTION_URL="https://app.vnoc.com"
VNOC_DOMAIN_ID="971"
# Referrals product (product_id 3)
VNOC_REFERRALS_PRODUCT_ID="3"
VNOC_REFERRALS_ATTRIBUTION_TOKEN=""
# Referrals Tier product (product_id 11)
VNOC_REFERRALSTIER_PRODUCT_ID="11"
VNOC_REFERRALSTIER_ATTRIBUTION_TOKEN=""

# =============================================================================
# Support inbox + autoresponder + AI (docs/PORTABLE-support-email.md)
# Requires: mysql referral_program < prisma/sql/support_inbox.sql && pnpm prisma generate
# =============================================================================
# Mail transport: "ses" (default) or "resend"
EMAIL_PROVIDER="ses"
# RESEND_API_KEY=""                 # only if EMAIL_PROVIDER=resend
# SES creds (EMAIL_PROVIDER=ses). Region falls back SES_REGION → AWS_SES_REGION → AWS_REGION
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
# From / reply-to for support mail (SUPPORT_FROM_EMAIL → CONTACT_EMAIL → AWS_SES_FROM_EMAIL)
SUPPORT_FROM_EMAIL="support@referrals.com"
CONTACT_EMAIL="support@referrals.com"
# Autoresponder: set to 0 to disable without uninstalling
SUPPORT_AUTORESPONDER="1"
SUPPORT_AUTORESPONDER_SITE_NAME="Referrals.com"
# AI first-reply: needs OPENAI_API_KEY; set SUPPORT_AI_ENABLED=0 to disable
SUPPORT_AI_ENABLED="1"
# OPENAI_SUPPORT_MODEL="gpt-4o-mini"   # optional override
# Inbound email → ticket threading webhook (POST /api/webhooks/support-inbound)
SUPPORT_INBOUND_WEBHOOK_SECRET=""
