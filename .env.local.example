# Copy to `.env.local` and fill in values. Never commit `.env.local`.
# See docs/shopify-integration.md for Shopify Partner + Vercel setup.

# --- App ---
DATABASE_URL="mysql://user:password@host:3306/referrals"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
AUTH_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Brand analysis pipeline ---
# Random string; required in production so /api/brands/analyze/[jobId]/run/* accepts triggers.
# Omit locally — modules run in-process instead of HTTP fan-out.
ANALYSIS_INTERNAL_SECRET=""

# --- Shopify (R2) ---
# Server: OAuth token exchange in /api/integrations/shopify/oauth
SHOPIFY_CLIENT_ID=""
SHOPIFY_CLIENT_SECRET=""
# Browser: authorize redirect on /integrations/shopify (same Client ID as above)
NEXT_PUBLIC_SHOPIFY_CLIENT_ID=""
# Legacy local names still work if you have an old .env:
# SHOPIFY_API_KEY=          # alias for SHOPIFY_CLIENT_ID
# SHOPIFY_API_SECRET=       # alias for SHOPIFY_CLIENT_SECRET
